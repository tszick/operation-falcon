{
  "name": "vector-flight",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Böngészős vadászrepülő-szimulátor",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "check": "node scripts/check-syntax.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run lint && npm run format:check && npm test",
    "audit": "npm audit --audit-level=moderate",
    "postinstall": "node scripts/sync-vendor.mjs",
    "vendor:sync": "node scripts/sync-vendor.mjs"
  },
  "engines": {
    "node": "^24.22.0 || >=26.12.0 <27",
    "npm": ">=11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "i18next": "27.1.0",
    "ws": "8.22.2"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
