# Optional: copy to .env, or use docker compose --env-file .env.docker.example ...
FALCON_BIND_ADDRESS=127.0.0.1
FALCON_PORT=5173
FALCON_MEMORY_LIMIT=512m
FALCON_CPUS=1.0
# Exact browser Host headers including the port, comma-separated; no URL scheme.
# Example for LAN access: FALCON_BIND_ADDRESS=0.0.0.0 and ALLOWED_HOSTS=192.168.1.50:5173
ALLOWED_HOSTS=
# For HTTPS-terminating reverse proxies, set the exact public HTTPS origin.
# Preserve the browser Host header; also add that hostname to ALLOWED_HOSTS.
# Example: PUBLIC_ORIGIN=https://falcon.example.com and ALLOWED_HOSTS=falcon.example.com
PUBLIC_ORIGIN=
